{
  "name": "linkedin-company-tracker",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {

    "lint": "echo 'no linting yet'",

    "check-node-engine": "npx check-node-engine",
    "check-requires": "npx used-deps-analyzer ./package.json ./src --no-dev",
    "check-updates": "npx check-version-modules --no-fail-at-major --fail-at-minor --fail-at-patch",
    "unit-tests": "echo 'no unit tests yet'",
    "unit-tests-local": "echo 'no unit tests yet'",

    "icons": "node scripts/generate-icons.mjs",
    "dev": "npm run icons && vite",
    "build": "npm run icons && tsc && vite build",
    "preview": "vite preview",

    "tests": "npm run lint && npm run check-node-engine && npm run check-requires && npm run check-updates && npm run build && npm run unit-tests-local"

  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@types/chrome": "0.3.4",
    "check-node-engine": "1.2.0",
    "check-version-modules": "2.5.0",
    "husky": "9.1.7",
    "used-deps-analyzer": "0.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22.23.3"
  }

}
