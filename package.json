{
  "name": "linkedin-company-tracker",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {

    "lint-back": "npx eslint --config .eslintrc-back.cjs --ext .ts,.cts,.mts ./lib/src/**/*",
    "lint-front": "echo 'no linting front yet'",
    "lint-tests": "echo 'no linting tests yet'",
    "lint": "npm run lint-back && npm run lint-front && npm run lint-tests",

    "clean-back": "npx rimraf ./lib/cjs",
    "clean-front": "npx rimraf ./public/dist",
    "clean": "npm run clean-back && npm run clean-front",

    "build-back": "npm run clean-back && npx webpack",
    "build-front": "echo 'no build front yet'",
    "build": "npm run build-back && npm run build-front",

    "check-node-engine": "npx check-node-engine",
    "check-requires": "npx used-deps-analyzer ./package.json ./lib/src --no-dev",
    "check-updates": "npx check-version-modules --no-fail-at-major --fail-at-minor --fail-at-patch",
    "unit-tests": "node --import ./test/register.js ./node_modules/mocha/bin/mocha.js \"test/**/*.test.js\"",
    "unit-tests-local": "npx nyc --reporter=html --reporter=text node --import ./test/register.js ./node_modules/mocha/bin/mocha.js \"test/**/*.test.js\"",

    "tests": "npm run lint && npm run check-node-engine && npm run check-requires && npm run check-updates && npm run build && npm run unit-tests-local",

    "zip": "npx web-ext build --source-dir ./lib/dist --artifacts-dir ./lib/build --overwrite-dest --no-input"

  },

  "bin": {},
  "files": [
    "/lib/cjs"
  ],
  "engines": {
    "node": ">=22.23.3"
  },

  "dependencies": {},
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.4",
    "check-node-engine": "1.2.0",
    "check-version-modules": "2.5.0",
    "copy-webpack-plugin": "14.0.0",
    "eslint-plugin-personnallinter": "git+ssh://git@github.com/Psychopoulet/eslint-plugin-personnallinter",
    "html-webpack-plugin": "5.6.8",
    "husky": "9.1.7",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "rimraf": "6.1.3",
    "terser-webpack-plugin": "5.6.1",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "used-deps-analyzer": "0.4.0",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  },

  "keywords": [
    "linkedin",
    "company",
    "tracker",
    "extension",
    "chrome",
    "enhancement"
  ],
  "author": "Sébastien VIDAL",
  "contributors": [],
  "license": "ISC",

  "homepage": "https://github.com/Psychopoulet/linkedin-company-tracker#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/Psychopoulet/linkedin-company-tracker"
  },
  "bugs": {
    "url": "https://github.com/Psychopoulet/linkedin-company-tracker/issues"
  }

}
