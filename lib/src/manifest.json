{
  "manifest_version": 3,
  "name": "LinkedIn Company Tracker",
  "version": "1.0.0",
  "description": "Suivi des sociétés LinkedIn avec indicateurs de criticité.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Sociétés LinkedIn"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/company/*"],
      "js": ["src/content/linkedin-company.ts"],
      "css": ["src/styles/content.css"]
    },
    {
      "matches": [
        "https://www.linkedin.com/jobs/search/*",
        "https://www.linkedin.com/jobs/search-results",
        "https://www.linkedin.com/jobs/search-results/*",
        "https://www.linkedin.com/jobs/view/*",
        "https://www.linkedin.com/jobs-tracker",
        "https://www.linkedin.com/jobs-tracker/*"
      ],
      "js": ["src/content/linkedin-jobs.ts"],
      "css": ["src/styles/content.css"]
    }
  ]
}
